# Keep line endings LF everywhere, whatever machine the repo is cloned on.
# A Makefile or shell script with CRLF endings fails in a Linux container, and
# the data files are read with fscanf, which is happier without stray carriage
# returns.
* text=auto eol=lf

*.c      text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.dat    text eol=lf
*.txt    text eol=lf
Makefile text eol=lf
run      text eol=lf
