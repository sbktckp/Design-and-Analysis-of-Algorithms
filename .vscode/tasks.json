{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build active file",
      "type": "shell",
      "command": "mkdir -p \"${fileDirname}/bin\" && gcc -std=c17 -O2 -o \"${fileDirname}/bin/${fileBasenameNoExtension}\" \"${file}\" -lm",
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "run active file",
      "type": "shell",
      "command": "mkdir -p bin && gcc -std=c17 -O2 -o \"bin/${fileBasenameNoExtension}\" \"${fileBasename}\" -lm && echo '--- running from' $(pwd) '---' && \"./bin/${fileBasenameNoExtension}\"",
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "focus": true }
    },
    {
      "label": "build everything",
      "type": "shell",
      "command": "make",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
