#!/usr/bin/env bash
#
# Build and run any program by its number, from anywhere in the repo.
#
#   ./run                    list everything
#   ./run 6.1                the full version of Prim's MST
#   ./run compact/6.1        the short lab record version of the same thing
#   ./run 2.1 150 in.dat out.dat      extra words are passed to the program
#   ./run "assignment 1/1.1"          the assignment copy of a shared number
#   ./run "assignment 1/compact/1.1"  and its compact version
#
# Anything before the last slash narrows the folder, one word per slash, and
# matching is case insensitive on any part of the path. Without a compact
# segment only full versions are considered, and when a number lives in both a
# day and an assignment the day wins, so a bare number never asks a question.
# The script changes into the program's own folder first, because the programs
# open their input files by relative path.
#
# If the executable bit did not survive the clone, call it as: bash run 6.1

set -euo pipefail
cd "$(dirname "$0")"

if [ "$#" -eq 0 ]; then
	printf 'Full versions:\n\n'
	find . -mindepth 2 -maxdepth 2 -name '*.c' | sort | while IFS= read -r p; do
		printf '  %-34s %s\n' "$(basename "$p" .c)" "$(dirname "${p#./}")"
	done
	printf '\nCompact versions, same numbers with compact/ in front:\n\n'
	find . -mindepth 3 -maxdepth 3 -path '*/compact/*' -name '*.c' | sort | while IFS= read -r p; do
		printf '  compact/%-26s %s\n' "$(basename "$p" .c)" "$(dirname "${p#./}")"
	done
	printf '\nFor example:  ./run 6.1    or    ./run compact/6.1\n'
	exit 0
fi

query="$1"
shift

number=${query##*/}
if [ "$query" != "$number" ]; then
	hint=${query%/*}
else
	hint=""
fi

matches=$(find . -mindepth 2 -maxdepth 3 -name "${number}_*.c" | sort)

want_compact=0
if [ -n "$hint" ]; then
	old_ifs=$IFS
	IFS='/'
	for part in $hint; do
		if [ "$(printf '%s' "$part" | tr 'A-Z' 'a-z')" = "compact" ]; then
			want_compact=1
		fi
		matches=$(printf '%s\n' "$matches" | grep -iF -- "$part" || true)
	done
	IFS=$old_ifs
fi

if [ "$want_compact" -eq 0 ]; then
	matches=$(printf '%s\n' "$matches" | grep -v '/compact/' || true)
fi

days=$(printf '%s\n' "$matches" | grep -i '^\./day ' || true)
if [ -n "$days" ]; then
	matches=$days
fi

count=$(printf '%s\n' "$matches" | grep -c . || true)

if [ "$count" -eq 0 ]; then
	printf 'Nothing matches %s. Run ./run with no arguments to see the list.\n' "$query" >&2
	exit 1
fi

if [ "$count" -gt 1 ]; then
	printf 'The number %s exists in more than one place:\n\n' "$number" >&2
	printf '%s\n' "$matches" | while IFS= read -r p; do printf '  %s\n' "$(dirname "${p#./}")" >&2; done
	printf '\nName one of them, for example:\n' >&2
	printf '%s\n' "$matches" | while IFS= read -r p; do
		folder=$(dirname "${p#./}")
		case "$folder" in
		*/compact) tag="$(printf '%s' "${folder%/compact}" | cut -d' ' -f1,2 | tr 'A-Z' 'a-z')/compact" ;;
		*) tag=$(printf '%s' "$folder" | cut -d' ' -f1,2 | tr 'A-Z' 'a-z') ;;
		esac
		printf '  ./run "%s/%s"\n' "$tag" "$number" >&2
	done
	exit 1
fi

folder=$(dirname "$matches")
program=$(basename "$matches" .c)
make -s -C "$folder" "bin/$program"
cd "$folder"
exec "./bin/$program" "$@"
